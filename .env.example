# Only needed to call a real Jev. Every test runs without it.
TYPESAFE_API_KEY=

# Autonomous provider. Codex CLI must be signed in with `codex` first.
AGENT_PROVIDER=luna_codex
CODEX_MODEL=gpt-5.6-luna
RUN_ID=run-001
CHECKPOINT_INTERVAL_MINUTES=10
STUCK_WARNING_THRESHOLD=0.70
STUCK_RECOVERY_THRESHOLD=0.85
STREAM_ENABLED=false
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
TWITCH_STREAM_KEY=
TWITCH_CHANNEL=

# Point at the local gateway shim, a recording proxy, or the fake. Unset means the
# direct API at https://api.typesafe.ai.
JEV_BASE_URL=

# Your own legally obtained Pokemon Red cartridge dump. Never in this repo.
POKEMON_ROM=Gold 97 Reforged v6.1c.gbc
GAME_ADAPTER=auto
PLAYER_NAME=JEV
RULES_PATH=config/game_rules.json
