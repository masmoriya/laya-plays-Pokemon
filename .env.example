# Only needed to call a real Jev. Every test runs without it.
TYPESAFE_API_KEY=

# Autonomous provider. Set LAYA_MODEL_PATH below for local Laya inference.
AGENT_PROVIDER=laya
CODEX_MODEL=gpt-5.6-luna # optional Luna screen reader only
# Set this to a downloaded Laya checkpoint to let the game client start its local sidecar.
# LAYA_MODEL_PATH=
# LAYA_AUTOSTART=1
# Luna checks the visible map only when collision data is uncertain or walking
# stalls. Set to 0 to disable Codex model calls; Luna never chooses controls.
LAYA_VISION=1
RUN_ID=run-001
CHECKPOINT_INTERVAL_MINUTES=10
STUCK_WARNING_THRESHOLD=0.70
STUCK_RECOVERY_THRESHOLD=0.85
STREAM_ENABLED=false
STREAM_WIDTH=1920
STREAM_HEIGHT=1080
STREAM_FPS=30
TWITCH_STREAM_KEY=
TWITCH_CHANNEL=

# Point at the local gateway shim, a recording proxy, or the fake. Unset means the
# direct API at https://api.typesafe.ai.
JEV_BASE_URL=

# Optional per-million-token rates for the live usage panel. Jev defaults to its
# published input rate; Luna stays cost-unavailable unless your billing rate is known.
JEV_INPUT_PRICE_PER_1M=0.042
JEV_OUTPUT_PRICE_PER_1M=
CODEX_INPUT_PRICE_PER_1M=
CODEX_OUTPUT_PRICE_PER_1M=

# Your own legally obtained Pokemon Red cartridge dump. Never in this repo.
POKEMON_ROM=Gold 97 Reforged v6.1c.gbc
GAME_ADAPTER=auto
PLAYER_NAME=JEV
RULES_PATH=config/game_rules.json
